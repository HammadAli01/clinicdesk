{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm test *)",
      "Bash(pnpm test)",
      "Bash(pnpm lint *)",
      "Bash(pnpm lint)",
      "Bash(pnpm db:generate *)",
      "Bash(pnpm db:up)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec tsc *)",
      "Bash(docker compose ps)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git worktree list)"
    ],
    "ask": [
      "Bash(pnpm db:migrate *)",
      "Bash(pnpm db:migrate)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(stripe *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Edit(./.env*)",
      "Bash(pnpm drizzle-kit push *)",
      "Bash(npx drizzle-kit push *)",
      "Bash(drizzle-kit push *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-files.mjs\""
          }
        ]
      }
    ]
  }
}
