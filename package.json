{
  "name": "clinicdesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local src/server/db/seed.ts",
    "mcp": "tsx --env-file=.env.local mcp/server.ts",
    "mcp:staff": "tsx --env-file=.env.local mcp/server.ts --staff",
    "mcp:inspect": "npx @modelcontextprotocol/inspector npx tsx --env-file=.env.local mcp/server.ts",
    "jobs": "tsx --env-file=.env.local src/server/jobs/run.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tanstack/react-query": "^5.103.2",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "bullmq": "^6.3.8",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.5",
    "node-cron": "^4.6.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.6.2",
    "superjson": "^2.2.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@9.15.4"
}
